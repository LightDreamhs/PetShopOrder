# syntax=docker/dockerfile:1
# 前端镜像：nginx 托管「本地预构建」的静态产物。
# 服务器 2C2G 跑不动 node 构建（2026-09-23 拍板）：前端一律本地构建后上传产物，
# 本镜像只做 COPY，不再镜像内 pnpm install/build。
#   本地构建：cd frontend/h5   && pnpm build
#             cd frontend/admin && VITE_BASE_URL=/petshop-admin-7x9k2/ pnpm build
#   上传产物：两个 dist/. 分别 scp 到服务器仓库同路径（见 deploy/README.md「更新前端」）
# .dockerignore 已放行 frontend/{h5,admin}/dist，仅源码之外额外拷贝这两个产物目录。

# ===== 运行阶段 =====
FROM nginx:alpine
# H5 产物 → nginx 根目录；Admin 产物 → 隐秘路径目录（nginx.conf 中 alias 指向）
COPY frontend/h5/dist /usr/share/nginx/html
COPY frontend/admin/dist /usr/share/nginx/admin
EXPOSE 80
